[Unit]
Description=JOCTV V3.1 Gateway Phase2 Candidate (port 8775 WS + 8774 HTTP)
# 候选独立服务, 不碰生产 joctv-v31-gateway (:8765) / admin (:8090) / worker (:8767)
# 任务报告: reports/51-SEGMENT-TIMELINE-REAL-METRICS.md + reports/63-reflash.md
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/v3-gateway/interaction_core
ExecStart=/root/v3-ai/bin/python -u ./server_phase2_candidate.py
Restart=on-failure
RestartSec=5
# 候选端口: WS :8775 + HTTP :8774 (与生产 :8765/:8767/:8090 完全独立)
Environment=PORT=8775
Environment=PHASE2_HTTP_PORT=8774
Environment=PHASE2_GATEWAY_HTTP=1
# Phase2 验证用 flag (生产 :8765 不受影响, 候选专用)
Environment=WS_SEND_PROFILE=1
Environment=FACILITY_ATTRIBUTE_V31=1
Environment=PUNCTUATION_SEGMENT_V31=1
Environment=SENTENCE_SPLIT_V31=1
Environment=SENTENCE_SPLIT_MIN_LEN=18
Environment=TTS_BACKEND_BYPASS_8767=1
Environment=TTS_BYPASS_8767_URL=ws://127.0.0.1:8767
Environment=TTS_CACHE_ENABLED=0
Environment=ASR_WARM_KEEPALIVE_V31=0
Environment=USE_AEC=0
Environment=SEND_DELAY_MS=10
# 日志
StandardOutput=append:/root/phase2_candidate.log
StandardError=append:/root/phase2_candidate.log

[Install]
WantedBy=multi-user.target
